{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "commonjs",
    // verbatimModuleSyntax would reject ESM syntax while emitting CommonJS.
    "verbatimModuleSyntax": false,
    "moduleResolution": "node10",
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
